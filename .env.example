# MOA runtime configuration. Copy values into your Kubernetes Secret/ConfigMap
# or local environment; the application reads these flat env vars directly.

# Required runtime endpoints
MOA_DATABASE_URL=postgres://moa_owner:change-me@postgres:5432/moa?sslmode=disable
# Optional direct/admin URL used only for database migrations.
MOA_DATABASE_ADMIN_URL=
# Required only for sandbox workspace maintenance/admit. Its login must be a
# member of the NOLOGIN `moa_workspace_maintenance` role and must be distinct
# from ordinary runtime and admin credentials.
MOA_DATABASE_MAINTENANCE_URL=
MOA_DATABASE_MAX_CONNECTIONS=5
MOA_DATABASE_BACKGROUND_MAX_CONNECTIONS=1
MOA_DATABASE_CONNECT_TIMEOUT_SECONDS=3
MOA_RESTATE_ADMIN_URL=http://restate:9070
MOA_RESTATE_INGRESS_URL=http://restate:8080
MOA_RUNTIME_CACHE_BACKEND=redis
MOA_RUNTIME_CACHE_REDIS_URL=redis://127.0.0.1:10051/0

# Envelope encryption. Every orchestrator replica and maintenance Job must use
# the same Postgres state and generation-named Secret directory. Each file is a
# base64-encoded 32-byte root key; never place key material in environment vars.
MOA_KMS_PROVIDER=postgres
MOA_KMS_ROOT_KEY_DIR=/var/run/secrets/moa-kms/root-keys
MOA_KMS_REQUIRED_GENERATION=primary

# Edge process
MOA_EDGE_BIND=0.0.0.0:8080
MOA_EDGE_UPSTREAM=http://restate:8080
# Internal orchestrator listener used only for opaque connector credential writes.
MOA_EDGE_CONNECTOR_CREDENTIAL_UPSTREAM=http://moa-orchestrator:10023
# Staged rollout switch for connector management and credential routes.
MOA_EDGE_CONNECTOR_MANAGEMENT_ENABLED=false
MOA_EDGE_DB_MAX_CONNECTIONS=8
MOA_EDGE_DB_MIN_CONNECTIONS=2
MOA_EDGE_DB_ACQUIRE_TIMEOUT_SECONDS=2

# Providers
MOA_GENERAL_DEFAULT_PROVIDER=openai
MOA_MODELS_MAIN=gpt-5.4
MOA_OPENAI_API_KEY=
MOA_ANTHROPIC_API_KEY=
MOA_GOOGLE_API_KEY=
MOA_COHERE_API_KEY=
MOA_ZEROENTROPY_API_KEY=
MOA_PROVIDERS_CONCURRENCY_SCOPE=global
MOA_PROVIDERS_CONCURRENCY_DEFAULT_MAX_IN_FLIGHT=16
MOA_PROVIDERS_CONCURRENCY_BLOCK_THRESHOLD_MS=2000
MOA_PROVIDERS_CONCURRENCY_LEASE_TTL_MS=600000
MOA_PROVIDERS_STREAM_TIMEOUTS_FIRST_BYTE_MS=30000
MOA_PROVIDERS_STREAM_TIMEOUTS_IDLE_MS=60000
MOA_PROVIDERS_STREAM_TIMEOUTS_TOTAL_MS=300000

# Durable execution. This positive per-run physical window bounds live attached
# ExecutionTask invocations; pending task rows remain storage-only. It is
# independent of logical max_tasks and provider concurrency limits.
MOA_EXECUTION_MAX_IN_FLIGHT_TASKS=64

# Auth and authorization
MOA_AUTH_HEADER_TRUST=strict
MOA_AUTH_PROVIDER=local
MOA_AUTHZ_ENGINE=openfga
MOA_AUTHZ_OPENFGA_URL=http://openfga:8080
MOA_AUTHZ_OPENFGA_PRESHARED_KEY=
MOA_AUTHZ_OPENFGA_STORE_ID=
MOA_AUTHZ_OPENFGA_MODEL_ID=
MOA_AUTHZ_OPENFGA_TIMEOUT_MS=5000

# Local runtime paths used by the orchestrator container
MOA_LOCAL_DOCKER_ENABLED=false
MOA_LOCAL_SANDBOX_DIR=/var/lib/moa/sandbox
MOA_LOCAL_MEMORY_DIR=/var/lib/moa/memory

# Memory sidecars
MOA_PII_SERVICE_URL=http://moa-pii-service:8080
MOA_MEMORY_AUTO_BOOTSTRAP=true
MOA_MEMORY_EMBEDDING_MODEL=cohere:embed-v4.0
MOA_MEMORY_VECTOR_EMBEDDER_NAME=gemini:gemini-embedding-2
MOA_MEMORY_RETRIEVAL_RERANKER_MODEL=noop
MOA_MEMORY_RETRIEVAL_RERANKER_LATENCY=

# Turbopuffer vector backend. Required for cloud partitions that select the
# Turbopuffer backend; leave the key empty for local pgvector-only development.
MOA_TURBOPUFFER_API_KEY=
MOA_TURBOPUFFER_BASE_URL=https://api.turbopuffer.com
MOA_TURBOPUFFER_ENVIRONMENT=prod
MOA_TURBOPUFFER_BAA=false

# Optional tenant knowledge providers and parsers
MOA_NANGO_API_KEY=
MOA_NANGO_WEBHOOK_SIGNING_KEY=
MOA_MERGE_API_KEY=
MOA_MERGE_WEBHOOK_SIGNATURE_KEY=
MOA_LLAMAPARSE_API_KEY=
MOA_LLAMAPARSE_WEBHOOK_SIGNING_KEY=
MOA_UNSTRUCTURED_API_KEY=
MOA_REDUCTO_API_KEY=
MOA_REDUCTO_WEBHOOK_SIGNING_KEY=

# Observability and metrics
MOA_OBSERVABILITY_ENABLED=true
MOA_OBSERVABILITY_SERVICE_NAME=moa-orchestrator
MOA_OBSERVABILITY_ENVIRONMENT=prod
MOA_OBSERVABILITY_OTLP_ENDPOINT=http://otel-collector:4317
MOA_OBSERVABILITY_OTLP_PROTOCOL=grpc
MOA_OBSERVABILITY_SAMPLE_RATE=1.0
MOA_LINEAGE_SINK=postgres

# Optional ClickHouse analytics read-model store. Lineage remains in Postgres.
# With the compose stack:
# `docker compose --profile clickhouse up -d` then http://clickhouse:8123.
MOA_CLICKHOUSE_URL=
MOA_CLICKHOUSE_USER=
MOA_CLICKHOUSE_PASSWORD=
# Runtime metrics exporter: otlp (production default, pushes to the collector),
# prometheus (development scrape endpoint, requires MOA_METRICS_PROMETHEUS_LISTEN),
# or disabled. Local development uses the scrape endpoint so `curl` works.
MOA_METRICS_EXPORTER=prometheus
MOA_METRICS_PROMETHEUS_LISTEN=0.0.0.0:9090

# Deployment security posture. `local` permits host-local hands with
# permissive permission defaults; `cloud` fails closed and requires a deny
# permission default, a persisted rule owner, and a credentialed cloud sandbox.
MOA_SECURITY_PROFILE=local

# Cloud hands default to a non-local provider. For host-local hands, keep
# MOA_SECURITY_PROFILE=local and set MOA_CLOUD_HANDS_DEFAULT_PROVIDER=local.
# Sandbox resource and egress policy. The deployment layer is the outermost of
# four layers (deployment, tenant, agent, hand route) intersected into every
# sandbox's effective profile; intersection only ever tightens. Every dimension
# is required and typed, and "no limit" must be stated as {"mode":"unbounded"}
# rather than left out or set to zero. Leaving this unset selects the built-in
# `local-development-unbounded` policy, which MOA_SECURITY_PROFILE=cloud refuses
# to start on.
# MOA_SANDBOX_POLICY_JSON={"deployment":{"revision":"deploy-2026-07","cpu":{"mode":"bounded","millicores":2000},"memory":{"mode":"bounded","mebibytes":4096},"ephemeral_disk":{"mode":"unbounded"},"egress":{"mode":"deny_all"},"idle_timeout":{"mode":"bounded","seconds":900},"max_lifetime":{"mode":"bounded","seconds":14400}}}

MOA_CLOUD_HANDS_DEFAULT_PROVIDER=e2b
MOA_CLOUD_HANDS_FALLBACK_PROVIDERS=
# Non-secret account/cell mapping. Provider credentials are read from the
# absolute, owner/mode-validated file selected by each entry; raw cloud keys are
# intentionally not accepted as MOA_CLOUD_HANDS_* environment variables.
# MOA_CLOUD_HANDS_PROVIDER_ACCOUNTS_JSON=[{"provider_account_id":"5df222fb-c303-5ae4-a494-8ae4de622e2d","generation":1,"provider":"e2b","isolation_cell":"canary-a","api_origin":"https://api.e2b.dev","toolbox_origin":null,"sandbox_domain":"e2b.app","default_runtime":"base","project_fingerprint":"e2b:project:canary-a","credential":{"path":"/var/run/secrets/moa-hand-providers/e2b","owner_uid":10001}}]
# Optional durable identity for the deterministic local lane. It has no remote
# credential/origin, but must still be exact and non-caller-selectable.
# MOA_LOCAL_PROVIDER_ACCOUNT_JSON={"provider_account_id":"f7e7ba62-d15f-5c06-8f16-595d31023496","generation":1,"isolation_cell":"local-single-replica"}

# Shared object-store transport. Local docker compose provides digest-pinned,
# PVC-backed RustFS and creates separate attachment/checkpoint buckets. Cloud
# sandbox checkpoints require workload_identity and no static key variables.
MOA_OBJECT_STORE_BACKEND=s3
MOA_OBJECT_STORE_CREDENTIAL_MODE=static
MOA_OBJECT_STORE_REGION=us-east-1
MOA_OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
MOA_OBJECT_STORE_ACCESS_KEY_ID=moaadmin
MOA_OBJECT_STORE_SECRET_ACCESS_KEY=moa-local-dev-secret
MOA_OBJECT_STORE_ALLOW_HTTP=true
MOA_OBJECT_STORE_VIRTUAL_HOSTED_STYLE=false
MOA_SESSION_ATTACHMENT_BUCKET=moa-session-attachments
MOA_SESSION_ATTACHMENT_PREFIX=session-attachments
MOA_SANDBOX_CHECKPOINT_BUCKET=moa-workspace-checkpoints
MOA_SANDBOX_CHECKPOINT_PREFIX=workspace-checkpoints
MOA_SANDBOX_CHECKPOINT_BUCKET_VERSIONING=unversioned_required
MOA_SANDBOX_CHECKPOINT_VERSIONING_OBSERVATION_MAXIMUM_AGE_SECONDS=60
MOA_SANDBOX_CHECKPOINT_VERSIONING_OBSERVATION_TIMEOUT_SECONDS=10

# Durable workspace rollout. The fail-safe default is disabled. Maintenance
# runs only cleanup/reconciliation; admit additionally requires an exact canary
# and a positive quota route for every allowlisted tenant.
MOA_SANDBOX_WORKSPACE_MODE=disabled
MOA_SANDBOX_WORKSPACE_OPERATION_RETENTION_SECONDS=604800
MOA_SANDBOX_WORKSPACE_MAXIMUM_OPERATION_SECONDS=86400
MOA_SANDBOX_WORKSPACE_RECONCILIATION_CLAIM_TTL_SECONDS=60
MOA_SANDBOX_WORKSPACE_REAPER_HEARTBEAT_MAXIMUM_AGE_SECONDS=60
# MOA_SANDBOX_WORKSPACE_CANARY_JSON={"provider_account_id":"5df222fb-c303-5ae4-a494-8ae4de622e2d","provider_account_generation":1,"isolation_cell":"canary-a","tenant_allowlist":["ae88b9a9-35e8-5ce4-a4de-8f5172c17115"]}
# MOA_SANDBOX_WORKSPACE_QUOTA_ROUTES_JSON=[{"tenant_id":"ae88b9a9-35e8-5ce4-a4de-8f5172c17115","provider_account_id":"5df222fb-c303-5ae4-a494-8ae4de622e2d","provider_account_generation":1,"max_workspaces":10,"max_active_hands":2,"max_checkpoints":100,"max_logical_bytes":10737418240}]

# Optional messaging adapter settings
MOA_MESSAGING_SLACK_TOKEN=
MOA_MESSAGING_SLACK_APP_TOKEN=
MOA_MESSAGING_POSTMARK_BASE_URL=https://api.postmarkapp.com
MOA_MESSAGING_POSTMARK_MESSAGE_STREAM=outbound
MOA_MESSAGING_EMAIL_FROM=
MOA_MESSAGING_EMAIL_REPLY_TO=
MOA_MESSAGING_TWILIO_BASE_URL=https://api.twilio.com

# Optional live Postmark validation
MOA_RUN_LIVE_POSTMARK_TESTS=0
POSTMARK_SERVER_API_TOKEN=
POSTMARK_TEST_FROM=
POSTMARK_TEST_TO=
POSTMARK_TEST_MESSAGE_STREAM=outbound

# Optional live Twilio SMS validation
MOA_RUN_LIVE_TWILIO_TESTS=0
TWILIO_ACCOUNT_SID=
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_TEST_TO=

# Operational controls
MOA_REQUIRE_RESTATE_REGISTRATION_FOR_READINESS=true
MOA_DEREGISTER_ON_SHUTDOWN=true
MOA_SKIP_FGA=false
# Maintenance/admit require this to be exactly 7 and reject MOA_SKIP_FGA.
MOA_AUTHZ_OPENFGA_MODEL_VERSION=7
MOA_PRIVACY_APPROVAL_PUBLIC_KEY_HEX=
MOA_PRIVACY_EXPORT_SIGNING_KEY_HEX=
MOA_PRIVACY_EXPORT_SIGNING_KEY_ID=
MOA_LINEAGE_AUDIT_SIGNING_KEY_HEX=
MOA_LINEAGE_AUDIT_SIGNING_KEY_ID=
MOA_PII_VAULT_SECRET_HEX=
RUST_LOG=info
