# MOA runtime configuration. Copy values into your Kubernetes Secret/ConfigMap
# or local environment; the application reads these flat env vars directly.

# Required runtime endpoints
MOA_DATABASE_URL=postgres://moa_owner:change-me@postgres:5432/moa?sslmode=disable
# Optional direct/admin URL used only for database migrations.
MOA_DATABASE_ADMIN_URL=
MOA_DATABASE_MAX_CONNECTIONS=5
MOA_DATABASE_BACKGROUND_MAX_CONNECTIONS=1
MOA_DATABASE_CONNECT_TIMEOUT_SECONDS=3
MOA_RESTATE_ADMIN_URL=http://restate:9070
MOA_RESTATE_INGRESS_URL=http://restate:8080
MOA_RUNTIME_CACHE_BACKEND=redis
MOA_RUNTIME_CACHE_REDIS_URL=redis://127.0.0.1:10051/0

# Envelope encryption. Every orchestrator replica and maintenance Job must use
# the same Postgres state and generation-named Secret directory. Each file is a
# base64-encoded 32-byte root key; never place key material in environment vars.
MOA_KMS_PROVIDER=postgres
MOA_KMS_ROOT_KEY_DIR=/var/run/secrets/moa-kms/root-keys
MOA_KMS_REQUIRED_GENERATION=primary

# Edge process
MOA_EDGE_BIND=0.0.0.0:8080
MOA_EDGE_UPSTREAM=http://restate:8080
MOA_EDGE_DB_MAX_CONNECTIONS=8
MOA_EDGE_DB_MIN_CONNECTIONS=2
MOA_EDGE_DB_ACQUIRE_TIMEOUT_SECONDS=2

# Providers
MOA_GENERAL_DEFAULT_PROVIDER=openai
MOA_MODELS_MAIN=gpt-5.4
MOA_OPENAI_API_KEY=
MOA_ANTHROPIC_API_KEY=
MOA_GOOGLE_API_KEY=
MOA_COHERE_API_KEY=
MOA_ZEROENTROPY_API_KEY=
MOA_PROVIDERS_CONCURRENCY_SCOPE=global
MOA_PROVIDERS_CONCURRENCY_DEFAULT_MAX_IN_FLIGHT=16
MOA_PROVIDERS_CONCURRENCY_BLOCK_THRESHOLD_MS=2000
MOA_PROVIDERS_CONCURRENCY_LEASE_TTL_MS=600000
MOA_PROVIDERS_STREAM_TIMEOUTS_FIRST_BYTE_MS=30000
MOA_PROVIDERS_STREAM_TIMEOUTS_IDLE_MS=60000
MOA_PROVIDERS_STREAM_TIMEOUTS_TOTAL_MS=300000

# Auth and authorization
MOA_AUTH_HEADER_TRUST=strict
MOA_AUTH_PROVIDER=local
MOA_AUTHZ_ENGINE=openfga
MOA_AUTHZ_OPENFGA_URL=http://openfga:8080
MOA_AUTHZ_OPENFGA_PRESHARED_KEY=
MOA_AUTHZ_OPENFGA_STORE_ID=
MOA_AUTHZ_OPENFGA_MODEL_ID=
MOA_AUTHZ_OPENFGA_TIMEOUT_MS=5000
MOA_AUTH_AUTH0_WEBHOOK_SECRET=

# Third-party OAuth token storage. The Postgres provider encrypts tokens through
# the same durable KMS keyring used by memory sealing. Supply refresh JSON from a
# Secret because each connection entry can contain a direct client_secret.
MOA_TOKEN_VAULT_PROVIDER=none
MOA_TOKEN_VAULT_REFRESH_JSON={}

# Local runtime paths used by the orchestrator container
MOA_LOCAL_DOCKER_ENABLED=false
MOA_LOCAL_SANDBOX_DIR=/var/lib/moa/sandbox
MOA_LOCAL_MEMORY_DIR=/var/lib/moa/memory

# Memory sidecars
MOA_PII_SERVICE_URL=http://moa-pii-service:8080
MOA_MEMORY_AUTO_BOOTSTRAP=true
MOA_MEMORY_EMBEDDING_MODEL=cohere:embed-v4.0
MOA_MEMORY_VECTOR_EMBEDDER_NAME=gemini:gemini-embedding-2
MOA_MEMORY_RETRIEVAL_RERANKER_MODEL=noop
MOA_MEMORY_RETRIEVAL_RERANKER_LATENCY=

# Turbopuffer vector backend. Required for cloud partitions that select the
# Turbopuffer backend; leave the key empty for local pgvector-only development.
MOA_TURBOPUFFER_API_KEY=
MOA_TURBOPUFFER_BASE_URL=https://api.turbopuffer.com
MOA_TURBOPUFFER_ENVIRONMENT=prod
MOA_TURBOPUFFER_BAA=false

# Optional tenant knowledge providers and parsers
MOA_NANGO_API_KEY=
MOA_NANGO_WEBHOOK_SIGNING_KEY=
MOA_MERGE_API_KEY=
MOA_MERGE_WEBHOOK_SIGNATURE_KEY=
MOA_LLAMAPARSE_API_KEY=
MOA_LLAMAPARSE_WEBHOOK_SIGNING_KEY=
MOA_UNSTRUCTURED_API_KEY=
MOA_REDUCTO_API_KEY=
MOA_REDUCTO_WEBHOOK_SIGNING_KEY=

# Observability and metrics
MOA_OBSERVABILITY_ENABLED=true
MOA_OBSERVABILITY_SERVICE_NAME=moa-orchestrator
MOA_OBSERVABILITY_ENVIRONMENT=prod
MOA_OBSERVABILITY_OTLP_ENDPOINT=http://otel-collector:4317
MOA_OBSERVABILITY_OTLP_PROTOCOL=grpc
MOA_OBSERVABILITY_SAMPLE_RATE=1.0
MOA_OBSERVABILITY_LINEAGE_ENABLED=true
MOA_OBSERVABILITY_LINEAGE_JOURNAL_PATH=/var/lib/moa/lineage-journal

# Optional ClickHouse analytics store for turn_lineage rows. Leave the URL
# empty to keep everything in Postgres. With the compose stack:
# `docker compose --profile clickhouse up -d` then http://clickhouse:8123.
MOA_CLICKHOUSE_URL=
MOA_CLICKHOUSE_USER=
MOA_CLICKHOUSE_PASSWORD=
MOA_METRICS_ENABLED=true
MOA_METRICS_LISTEN=0.0.0.0:9090

# Cloud hands default to a non-local provider. For development-only host-local
# hands, set MOA_CLOUD_HANDS_DEFAULT_PROVIDER=local and
# MOA_CLOUD_HANDS_ALLOW_LOCAL=true explicitly.
MOA_CLOUD_HANDS_DEFAULT_PROVIDER=e2b
MOA_CLOUD_HANDS_FALLBACK_PROVIDERS=
MOA_CLOUD_HANDS_ALLOW_LOCAL=false
MOA_CLOUD_HANDS_DAYTONA_API_KEY=
MOA_CLOUD_HANDS_E2B_API_KEY=

# Session attachment object storage. Local docker compose provides RustFS at
# http://127.0.0.1:9000 and creates the default bucket.
MOA_SESSION_ATTACHMENT_BACKEND=s3
MOA_SESSION_ATTACHMENT_BUCKET=moa-session-attachments
MOA_SESSION_ATTACHMENT_PREFIX=session-attachments
MOA_SESSION_ATTACHMENT_REGION=us-east-1
MOA_SESSION_ATTACHMENT_ENDPOINT=http://127.0.0.1:9000
MOA_SESSION_ATTACHMENT_ACCESS_KEY_ID=moaadmin
MOA_SESSION_ATTACHMENT_SECRET_ACCESS_KEY=moa-local-dev-secret
MOA_SESSION_ATTACHMENT_ALLOW_HTTP=true
MOA_SESSION_ATTACHMENT_VIRTUAL_HOSTED_STYLE=false
# Cloud AWS S3: leave MOA_SESSION_ATTACHMENT_ENDPOINT unset and set ALLOW_HTTP=false.
# Cloud GCS: set BACKEND=gcs and optionally
# MOA_SESSION_ATTACHMENT_GCP_APPLICATION_CREDENTIALS_PATH=/var/run/secrets/gcp/application-default.json

# Optional messaging adapter settings
MOA_MESSAGING_SLACK_TOKEN=
MOA_MESSAGING_SLACK_APP_TOKEN=
MOA_MESSAGING_POSTMARK_BASE_URL=https://api.postmarkapp.com
MOA_MESSAGING_POSTMARK_MESSAGE_STREAM=outbound
MOA_MESSAGING_EMAIL_FROM=
MOA_MESSAGING_EMAIL_REPLY_TO=
MOA_MESSAGING_TWILIO_BASE_URL=https://api.twilio.com

# Optional live Postmark validation
MOA_RUN_LIVE_POSTMARK_TESTS=0
POSTMARK_SERVER_API_TOKEN=
POSTMARK_TEST_FROM=
POSTMARK_TEST_TO=
POSTMARK_TEST_MESSAGE_STREAM=outbound

# Optional live Twilio SMS validation
MOA_RUN_LIVE_TWILIO_TESTS=0
TWILIO_ACCOUNT_SID=
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_TEST_TO=

# Operational controls
MOA_REQUIRE_RESTATE_REGISTRATION_FOR_READINESS=true
MOA_DEREGISTER_ON_SHUTDOWN=true
MOA_SKIP_FGA=false
MOA_PRIVACY_APPROVAL_PUBLIC_KEY_HEX=
MOA_PRIVACY_EXPORT_SIGNING_KEY_HEX=
MOA_PRIVACY_EXPORT_SIGNING_KEY_ID=
MOA_LINEAGE_AUDIT_SIGNING_KEY_HEX=
MOA_LINEAGE_AUDIT_SIGNING_KEY_ID=
MOA_PII_VAULT_SECRET_HEX=
RUST_LOG=info
