          "format": "time_series",
          "rawSql": "SELECT day AS time, storage_partition_id AS metric, total_cost_cents / 100.0 AS value FROM analytics.daily_storage_partition_metrics WHERE $__timeFilter(day) ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Daily spend by storage partition (USD)",
      "type": "timeseries"
    }
