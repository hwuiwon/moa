#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

staged="$(git diff --cached --name-only --diff-filter=ACMR)"

if [ -z "$staged" ]; then
  echo "[pre-commit] no staged files — nothing to check"
  exit 0
fi

if grep -qE '\.rs$' <<< "$staged"; then
  echo "[pre-commit] checking Rust formatting"
  cargo fmt --all -- --check
fi

echo "[pre-commit] fast checks passed"
