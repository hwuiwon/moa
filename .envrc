dotenv

# --- graphify: pin every shell in this repo to the blessed interpreter --------
#
# graphify runs through `uv`, which manages an isolated interpreter per tool
# install (no system/pyenv Python involved). The repo pins an exact graphify
# version in .agents/skills/graphify/.graphify_version; this block keeps the
# installed `uv tool` graphify on that version so the /graphify skill, the
# .claude hooks, and `scripts/graphify` all resolve to the same environment.
#
# Reload this .envrc whenever the pinned version changes.
watch_file .agents/skills/graphify/.graphify_version

if has uv; then
  _gfy_want="$(tr -d '[:space:]' < .agents/skills/graphify/.graphify_version 2>/dev/null)"
  _gfy_have="$(uv tool list 2>/dev/null | awk '/^graphifyy /{gsub(/^v/,"",$2); print $2}')"
  _gfy_py="$(uv tool dir 2>/dev/null)/graphifyy/bin/python"
  # Has the gemini extra? (the `openai` package must import in the tool env)
  if [ -x "$_gfy_py" ] && "$_gfy_py" -c 'import openai' >/dev/null 2>&1; then
    _gfy_gemini=1
  else
    _gfy_gemini=0
  fi
  if [ -z "$_gfy_have" ]; then
    # Not installed — don't auto-install (this is a shared .envrc); just hint.
    log_status "graphify not installed; run 'make graphify' to pin graphifyy[gemini]==${_gfy_want}"
  elif [ "$_gfy_have" != "$_gfy_want" ] || [ "$_gfy_gemini" != 1 ]; then
    # Installed but drifted, or missing the gemini extra — re-pin via setup
    # (which installs graphifyy[gemini] at the pinned version).
    log_status "re-pinning graphify -> graphifyy[gemini]==${_gfy_want}"
    ./scripts/setup-graphify.sh >/dev/null 2>&1 \
      || log_status "graphify re-pin failed; run 'make graphify' manually"
  fi
  unset _gfy_want _gfy_have _gfy_py _gfy_gemini
else
  log_status "graphify: 'uv' not found on PATH; install it from https://docs.astral.sh/uv/"
fi
