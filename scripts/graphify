#!/usr/bin/env bash
set -euo pipefail

# Repo-pinned graphify launcher.
#
# Runs the exact graphify version recorded in
# .agents/skills/graphify/.graphify_version, independent of whatever graphify
# (if any) a contributor has installed globally. Used by the .claude hooks so
# every contributor and agent invokes the same version.
#
# uvx manages its own isolated, cached Python environment, so no pyenv/venv or
# `make graphify` install step is required for this to work — only `uv`.

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERSION_FILE="$ROOT/.agents/skills/graphify/.graphify_version"

if ! command -v uv >/dev/null 2>&1; then
  echo "error: 'uv' is required but not found on PATH (see https://docs.astral.sh/uv/)." >&2
  exit 1
fi

VERSION="$(tr -d '[:space:]' < "$VERSION_FILE")"
exec uvx --from "graphifyy==$VERSION" graphify "$@"
