---
source: crates/moa-analytics/tests/analytics_sql_offline.rs
expression: compiled.sql
---
SELECT d.event_type AS c0, d.session_id::TEXT AS c1, COUNT(*)::BIGINT AS c2, COALESCE(SUM(d.token_count), 0)::BIGINT AS c3 FROM analytics.event_fact AS d WHERE d.tenant_id = $1::UUID AND d.occurred_at BETWEEN $2::TIMESTAMPTZ AND $3::TIMESTAMPTZ GROUP BY 1, 2 ORDER BY c2 DESC LIMIT 50
