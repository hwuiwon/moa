---
source: crates/moa-analytics/tests/analytics_sql_offline.rs
expression: compiled.sql
---
SELECT d.active_plan_hash AS c0, d.skill_template_revision_uid::TEXT AS c1, d.status AS c2, d.logical_task_count AS c3, COUNT(*)::BIGINT AS c4, COALESCE(SUM(d.actual_cost_microusd), 0)::BIGINT AS c5, PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY d.queue_to_start_ms)::DOUBLE PRECISION AS c6, PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY d.duration_ms)::DOUBLE PRECISION AS c7 FROM analytics.execution_run_fact AS d WHERE d.tenant_id = $1::UUID AND d.started_at BETWEEN $2::TIMESTAMPTZ AND $3::TIMESTAMPTZ GROUP BY 1, 2, 3, 4 ORDER BY c4 DESC LIMIT 50
