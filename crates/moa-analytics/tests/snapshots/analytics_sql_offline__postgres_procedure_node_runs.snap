---
source: crates/moa-analytics/tests/analytics_sql_offline.rs
expression: compiled.sql
---
SELECT d.node_id AS c0, d.status AS c1, COUNT(*)::BIGINT AS c2, PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY d.duration_ms)::DOUBLE PRECISION AS c3 FROM analytics.procedure_node_run_fact AS d WHERE d.tenant_id = $1::UUID AND d.started_at BETWEEN $2::TIMESTAMPTZ AND $3::TIMESTAMPTZ GROUP BY 1, 2 ORDER BY c2 DESC LIMIT 50
