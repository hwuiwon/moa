---
source: crates/moa-analytics/tests/analytics_sql_offline.rs
expression: compiled.sql
---
SELECT d.capability_name AS c0, d.capability_version AS c1, d.status AS c2, d.failure_class AS c3, count() AS c4, ifNull(sum(d.actual_cost_microusd), 0) AS c5, ifNull(sum(d.citation_count), 0) AS c6, quantileExactInclusive(0.95)(d.queue_latency_ms) AS c7, quantileExactInclusive(0.95)(d.duration_ms) AS c8 FROM dim_execution_tasks AS d FINAL WHERE d.tenant_id = toUUID(?) AND d.started_at BETWEEN parseDateTime64BestEffort(?, 6, 'UTC') AND parseDateTime64BestEffort(?, 6, 'UTC') GROUP BY 1, 2, 3, 4 ORDER BY c4 DESC LIMIT 50
