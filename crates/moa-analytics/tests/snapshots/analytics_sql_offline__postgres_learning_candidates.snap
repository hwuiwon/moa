---
source: crates/moa-analytics/tests/analytics_sql_offline.rs
expression: compiled.sql
---
SELECT d.candidate_type AS c0, d.status AS c1, d.risk_class AS c2, COUNT(*)::BIGINT AS c3, AVG(d.confidence)::DOUBLE PRECISION AS c4 FROM analytics.learning_candidate_fact AS d WHERE d.tenant_id = $1::UUID AND d.updated_at BETWEEN $2::TIMESTAMPTZ AND $3::TIMESTAMPTZ GROUP BY 1, 2, 3 ORDER BY c3 DESC LIMIT 50
