---
source: crates/moa-analytics/tests/analytics_sql_offline.rs
expression: compiled.sql
---
SELECT toString(sac.agent_id) AS c0, d.channel AS c1, count() AS c2, quantileExactInclusive(0.95)(d.total_cost_cents) AS c3, ifNull(sum(ifNull(ev.tool_call_count, 0)), 0) AS c4, avg((d.total_input_tokens_cache_read / nullIf(d.total_input_tokens_uncached + d.total_input_tokens_cache_write + d.total_input_tokens_cache_read, 0))) AS c5, quantileExactInclusive(0.5)(((toUnixTimestamp64Micro(d.updated_at) - toUnixTimestamp64Micro(d.created_at)) / 1000000.0)) AS c6 FROM dim_sessions AS d FINAL LEFT JOIN dim_session_agent_context AS sac FINAL ON sac.session_id = d.session_id AND sac.tenant_id = d.tenant_id LEFT JOIN ( SELECT session_id, tenant_id, uniqExactIf(event_id, event_type = 'ToolCall') AS tool_call_count, uniqExactIf(event_id, event_type = 'Error') AS error_count FROM events_raw GROUP BY session_id, tenant_id ) AS ev ON ev.session_id = d.session_id AND ev.tenant_id = d.tenant_id WHERE d.tenant_id = toUUID(?) AND d.status = ? AND d.created_at BETWEEN parseDateTime64BestEffort(?, 6, 'UTC') AND parseDateTime64BestEffort(?, 6, 'UTC') GROUP BY 1, 2 ORDER BY c2 DESC LIMIT 50
