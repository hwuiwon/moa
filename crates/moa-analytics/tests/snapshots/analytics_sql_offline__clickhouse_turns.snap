---
source: crates/moa-analytics/tests/analytics_sql_offline.rs
expression: compiled.sql
---
SELECT d.model AS c0, d.turn_number AS c1, count() AS c2, quantileExactInclusive(0.95)(d.llm_ms) AS c3, avg(d.pipeline_ms) AS c4, avg(CAST(NULL AS Nullable(Float64))) AS c5, ifNull(sum(d.total_input_tokens), 0) AS c6 FROM turn_fact AS d FINAL LEFT JOIN dim_session_agent_context AS sac FINAL ON sac.session_id = d.session_id AND sac.tenant_id = d.tenant_id LEFT JOIN dim_sessions AS s FINAL ON s.session_id = d.session_id AND s.tenant_id = d.tenant_id WHERE d.tenant_id = toUUID(?) AND s.channel = ? AND d.finished_at BETWEEN parseDateTime64BestEffort(?, 6, 'UTC') AND parseDateTime64BestEffort(?, 6, 'UTC') GROUP BY 1, 2 ORDER BY c2 DESC LIMIT 50
