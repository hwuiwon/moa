{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moa.dev/schemas/moa-artifact-v1.schema.json",
  "title": "MOA Artifact Document v1",
  "type": "object",
  "required": ["kind", "metadata", "definition"],
  "properties": {
    "api_version": { "const": "moa.artifact/v1" },
    "kind": { "enum": ["skill", "connector", "workflow"] },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "version": { "type": "string" }
      }
    },
    "status": { "enum": ["draft", "published", "archived"] },
    "definition": {
      "type": "object",
      "required": ["type", "spec"],
      "properties": {
        "type": { "enum": ["skill", "connector", "workflow"] },
        "spec": { "type": "object" }
      }
    },
    "ui": { "type": "object" },
    "reference_resolutions": { "type": "array" }
  }
}
