{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moa.dev/schemas/moa-workflow-v1.schema.json",
  "title": "MOA Workflow Definition v1",
  "type": "object",
  "required": ["nodes", "edges"],
  "properties": {
    "input_schema": { "type": "object" },
    "state_schema": { "type": "object" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": [
              "start",
              "action",
              "condition",
              "approval",
              "agent",
              "end",
              "tool",
              "skill_action",
              "sub_agent",
              "parallel",
              "join",
              "wait_signal",
              "memory_read",
              "memory_write"
            ]
          },
          "ref": { "type": "string" },
          "skill_refs": { "type": "array", "items": { "type": "string" } },
          "tool_refs": { "type": "array", "items": { "type": "string" } },
          "condition": { "$ref": "#/$defs/condition" },
          "input": { "type": "object" },
          "max_turns": { "type": "integer", "minimum": 1 },
          "ui": { "type": "object" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "id": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "when": { "$ref": "#/$defs/condition" }
        }
      }
    },
    "ui": { "type": "object" }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "properties": {
            "type": { "const": "equals" },
            "left": { "type": "string" },
            "right": {}
          },
          "required": ["left", "right"]
        },
        {
          "properties": {
            "type": { "const": "exists" },
            "path": { "type": "string" }
          },
          "required": ["path"]
        },
        {
          "properties": {
            "type": { "const": "expression" },
            "language": { "type": "string" },
            "source": { "type": "string" }
          },
          "required": ["language", "source"]
        }
      ]
    }
  }
}
